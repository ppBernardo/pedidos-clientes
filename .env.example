# Copie para .env para mudar os padrões. Sem .env, o docker compose usa estes valores.
# Senhas só com letras e números: '$' quebra o compose, '@' e ':' quebram a DSN
# do MCP e ';' quebra a connection string. A política do SQL Server exige pelo
# menos 8 caracteres com maiúsculas, minúsculas e dígitos.

# Login sa (usado só pelo db-init para criar o banco)
SA_PASSWORD=Pedidos2026Sa
# Login pedidos_app (API): SELECT, INSERT em pedidos e itens, UPDATE só do estoque
APP_DB_PASSWORD=Pedidos2026App
# Login mcp_leitura (MCP do Claude Code): somente leitura
MCP_DB_PASSWORD=Pedidos2026Mcp

SQL_PORT=1433
API_PORT=8080
FRONTEND_PORT=3000
